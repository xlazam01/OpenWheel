# Private working area: never published (kept in the separate local Gitea repo OpenWheel-private)
/_private/

# Build output / caches
.pio/
__pycache__/
.pytest_cache/
*.pyc
tools/hwtest/reports/

# Editor / local tool settings
.vscode/
.claude/settings.local.json

# PlatformIO IDE re-creates an empty project skeleton in the repo root: not wanted, the project is in fw/
/platformio.ini
/src/
/lib/
/include/
/test/

# KiCad local state and backups
hw/*-backups/
hw/*.kicad_prl
hw/*.kicad_sch-bak
hw/*.lck
hw/*.log
hw/fp-info-cache
hw/bck/
hw/.history/
hw/production/

# CAD working files: SolidCraft backups and locks, scratch copies, reference/check renders
*.sc.bak
.~*.lock
* copy.*
cad/_ref/
cad/_old/
# Solid Edge originals live in _private/cad-solidedge; keep stray copies out of the public tree
cad/*.par
cad/*.asm
cad/*.psm
cad/*.dft
cad/*.cfg
cad/PCB/

# .NET build output
bin/
obj/
*.user
.vs/

# staged driver build (registered with COM during development)
driver/ASCOM/dist/
driver/ASCOM/installer/Output/
